{
	"name" : "ivanghisleni/roundcube-imap",
	"description" : "A PHP imap client class extracted from roundcubemail",
	"license" : "GPL-3.0-or-later",
	"keywords" : [
		"imap"
	],
	"authors" : [{
			"name" : "Benedikt Carda",
			"email" : "carda@two-wings.net"
		},{
		"name" : "Ivan Ghisleni",
		"email" : "ivan.ghisleni@gmail.com"
	}
	],
	"require" : {
		"php" : ">=8.0"
	},
	"require-dev" : {
		"phpunit/phpunit" : "^9.6"
	},
	"replace": {
    },
	"autoload" : {
		"psr-4" : {
			"bjc\\roundcubeimap\\" : "src"
		}
	},
	"autoload-dev" : {
		"psr-4" : {
			"bjc\\roundcubeimap\\tests\\" : "tests"
		}
	},
	"scripts" : {
		"test" : "phpunit"
	}
}